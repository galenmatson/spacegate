{
  "schema_version": "spacegate.smart_tag_application_policies.v1",
  "policy_id": "spacegate_public_tag_application",
  "policy_version": "2026-08-06-v1",
  "claim_grammar": {
    "observed": {
      "public_name": "Observed",
      "marker": "O",
      "meaning": "Directly observed evidence supports the claim."
    },
    "accepted": {
      "public_name": "Accepted",
      "marker": "",
      "meaning": "Reviewed source evidence or accepted canonical structure supports the claim."
    },
    "derived": {
      "public_name": "Derived",
      "marker": "D",
      "meaning": "A deterministic calculation from accepted inputs supports the claim."
    },
    "modeled": {
      "public_name": "Model",
      "marker": "M",
      "meaning": "A named scientific model or screening policy supports the claim."
    },
    "likely": {
      "public_name": "Likely",
      "marker": "L",
      "meaning": "Reviewed evidence favors the claim above a defined confidence threshold."
    },
    "candidate": {
      "public_name": "Candidate",
      "marker": "?",
      "meaning": "Evidence makes the claim worth investigating but does not establish it."
    },
    "disputed": {
      "public_name": "Disputed",
      "marker": "!",
      "meaning": "Material accepted evidence conflicts or the subject binding remains unresolved."
    },
    "contextual": {
      "public_name": "Contextual",
      "marker": "@",
      "meaning": "The result depends on the observer, time, camera, or active session."
    }
  },
  "application_profiles": {
    "selected_stellar_class": {
      "claim_mode": "evidence_bound",
      "primary_scope": "star",
      "evidence_requirements": ["selected stellar classification with object scope and lineage"],
      "uncertainty_policy": "preserve the selected classification status and confidence",
      "conflict_policy": "exclude ambiguous or quarantined subject bindings",
      "rollup_policy": "member discovery only; retain the originating star",
      "eligible_surfaces": ["object_badge", "hierarchy", "all_tags", "filter", "hero_when_eligible"],
      "revisit_trigger": "selected classification, subject binding, or evaluator version changes"
    },
    "accepted_system_architecture": {
      "claim_mode": "accepted",
      "primary_scope": "system",
      "evidence_requirements": ["accepted canonical stellar membership count"],
      "uncertainty_policy": "do not count candidates or unresolved members",
      "conflict_policy": "defer when accepted containment is internally inconsistent",
      "rollup_policy": "direct system claim",
      "eligible_surfaces": ["system_root", "hierarchy", "all_tags", "filter", "hero_when_eligible"],
      "revisit_trigger": "accepted hierarchy or membership changes"
    },
    "derived_system_hierarchy": {
      "claim_mode": "derived",
      "primary_scope": "system",
      "evidence_requirements": ["accepted hierarchy containing a nested stellar group"],
      "uncertainty_policy": "describe accepted structure without claiming long term stability",
      "conflict_policy": "quarantine malformed or multiply bound hierarchy nodes",
      "rollup_policy": "direct system structure claim with relation lineage",
      "eligible_surfaces": ["system_root", "hierarchy", "all_tags", "filter", "hero_when_eligible"],
      "revisit_trigger": "hierarchy projection or evaluator version changes"
    },
    "accepted_planet_host": {
      "claim_mode": "accepted",
      "primary_scope": "system",
      "evidence_requirements": ["at least one confirmed, known, or published canonical planet"],
      "uncertainty_policy": "candidate and false positive evidence does not satisfy the claim",
      "conflict_policy": "defer unresolved host or component binding",
      "rollup_policy": "direct system claim with planet objects retained",
      "eligible_surfaces": ["system_root", "all_tags", "filter"],
      "revisit_trigger": "planet lifecycle or host binding changes"
    },
    "derived_planet_orbit": {
      "claim_mode": "derived",
      "primary_scope": "planet",
      "evidence_requirements": ["confirmed planet with selected orbital period and lineage"],
      "uncertainty_policy": "the accepted interval must not straddle the evaluator threshold when bounds exist",
      "conflict_policy": "exclude unresolved host bindings and conflicting selected facts",
      "rollup_policy": "member discovery only; retain the originating planet",
      "eligible_surfaces": ["planet_badge", "hierarchy", "all_tags", "filter", "hero_when_eligible"],
      "revisit_trigger": "selected period, uncertainty, lifecycle, host binding, or evaluator version changes"
    },
    "modeled_planet_screen": {
      "claim_mode": "modeled",
      "primary_scope": "planet",
      "evidence_requirements": ["confirmed planet and selected stellar or orbital inputs required by the pinned screen"],
      "uncertainty_policy": "screening intervals must remain distinguishable from habitability claims",
      "conflict_policy": "exclude missing inputs and unresolved host bindings",
      "rollup_policy": "member discovery only; retain the originating planet",
      "eligible_surfaces": ["planet_badge", "hierarchy", "all_tags", "filter", "hero_when_eligible"],
      "revisit_trigger": "screen inputs, host binding, or model version changes"
    },
    "derived_planet_category": {
      "claim_mode": "derived",
      "primary_scope": "planet",
      "evidence_requirements": ["confirmed planet with selected size or mass class and insolation class"],
      "uncertainty_policy": "retain boundary ambiguity and never imply composition from a broad proxy",
      "conflict_policy": "exclude unresolved category or host bindings",
      "rollup_policy": "member discovery only; retain the originating planet",
      "eligible_surfaces": ["planet_badge", "hierarchy", "all_tags", "filter", "hero_when_eligible"],
      "revisit_trigger": "planet measurement, lifecycle, host binding, or category policy changes"
    },
    "distance_presentation": {
      "claim_mode": "accepted",
      "primary_scope": "system",
      "evidence_requirements": ["selected public distance point estimate"],
      "uncertainty_policy": "do not imply interval-aware boundary certainty until intervals are carried",
      "conflict_policy": "exclude missing or nonphysical distances",
      "rollup_policy": "direct presentation claim",
      "eligible_surfaces": ["all_tags", "filter"],
      "revisit_trigger": "selected distance, interval support, or band policy changes"
    }
  },
